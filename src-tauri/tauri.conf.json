{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDeck",
  "identifier": "app.opendeck.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node ../scripts/build-sidecars.mjs && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenDeck",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm", "dmg"],
    "category": "Music",
    "publisher": "R4ph3rd",
    "copyright": "Copyright (c) R4ph3rd",
    "shortDescription": "Desktop DJ application",
    "longDescription": "OpenDeck is a desktop DJ application: two decks, mixer, effects, library and MIDI controller support.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "sound",
        "priority": "optional",
        "desktopTemplate": "linux/opendeck.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/opendeck.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "OpenDeck",
        "displayLanguageSelector": false
      },
      "wix": {
        "upgradeCode": "6bcb09fc-a2c9-5bb7-a0aa-15cb2d440f6f"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
