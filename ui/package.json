{
  "name": "opendeck-ui",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && pnpm --filter @opendeck/design-system typecheck",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "test": "vitest run && pnpm --filter @opendeck/design-system test",
    "tauri": "node scripts/tauri.mjs",
    "storybook": "pnpm --filter @opendeck/design-system storybook",
    "build-storybook": "pnpm --filter @opendeck/design-system build-storybook && storybook build -c .storybook",
    "storybook:viz": "storybook dev -p 6007 -c .storybook"
  },
  "dependencies": {
    "@opendeck/design-system": "workspace:*",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.24",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "9.1.21",
    "@storybook/react-vite": "9.1.21",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "storybook": "9.1.21",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
